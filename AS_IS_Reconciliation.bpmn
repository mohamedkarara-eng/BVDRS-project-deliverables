<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ASIS_Reconciliation" targetNamespace="https://strategizeit.example/bvdrs/bpmn" exporter="OpenAI BPMN Draft Generator" exporterVersion="1.0"><bpmn:collaboration id="Collaboration_Process_ASIS_Reconciliation"><bpmn:participant id="Participant_Process_ASIS_Reconciliation" name="AS-IS Process B — Reconciliation Application Lifecycle" processRef="Process_ASIS_Reconciliation" /></bpmn:collaboration><bpmn:process id="Process_ASIS_Reconciliation" name="AS-IS Process B — Reconciliation Application Lifecycle" isExecutable="false"><bpmn:documentation>AS-IS conceptual workflow based on the case. The model retains paper dossiers, local Excel registers, manual engineering/spatial checks, committee decisions, manual fees and paper certificates. The exact resubmission route, certificate-issuing role, notification details, and the post-appeal outcome handling are not fully specified by the case.</bpmn:documentation><bpmn:laneSet id="LaneSet_Process_ASIS_Reconciliation"><bpmn:lane id="Lane_ASIS_Recon_Applicant" name="Citizen / Legal Agent"><bpmn:flowNodeRef>Start_Recon_Application</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Submit_Paper_Dossier</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pay_Fees</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Applicant_Submit_Missing_Docs</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Receive_Rejection</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_File_Appeal</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Recon_TechCenter" name="Municipal Technical Centers (4 Centers)"><bpmn:flowNodeRef>Task_Check_Paper_Checklist</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Register_Local_Excel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Collect_Deposit</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Transfer_Paper_File</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TechCenter_Route_Docs</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Recon_Engineering" name="District Engineering Offices"><bpmn:flowNodeRef>Task_Locate_Building</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Engineering_Inspection</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Manual_Spatial_Check</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Recon_Committee" name="Reconciliation Committees (3; Weekly Meetings)"><bpmn:flowNodeRef>Task_Committee_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Committee_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Request_Documents</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Recon_Finance" name="Finance Department"><bpmn:flowNodeRef>Task_Calculate_Fee</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Issue_Payment_Voucher</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Recon_Admin" name="Certificate Issuance / Administrative Role (To Be Confirmed)"><bpmn:flowNodeRef>Task_Issue_Certificate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Mail_Certificate_Utilities</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Reconciliation_Complete</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Recon_Appeals" name="Separate Appellate Committee"><bpmn:flowNodeRef>Task_Review_Appeal</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Appeal_Outcome</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Recon_Application" name="Applicant Initiates Reconciliation Request"><bpmn:outgoing>Flow_RAS_01</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_Submit_Paper_Dossier" name="Submit Paper Application and Documents"><bpmn:documentation>The case lists ownership documents, ID, structural safety report, building photos and site sketch; power of attorney applies where an agent submits.</bpmn:documentation><bpmn:incoming>Flow_RAS_01</bpmn:incoming><bpmn:outgoing>Flow_RAS_02</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Check_Paper_Checklist" name="Check Paper Checklist"><bpmn:incoming>Flow_RAS_02</bpmn:incoming><bpmn:outgoing>Flow_RAS_03</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Register_Local_Excel" name="Register in Local Excel; Issue Receipt"><bpmn:incoming>Flow_RAS_03</bpmn:incoming><bpmn:outgoing>Flow_RAS_04</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Collect_Deposit" name="Collect / Record 25% Deposit"><bpmn:incoming>Flow_RAS_04</bpmn:incoming><bpmn:outgoing>Flow_RAS_05</bpmn:outgoing></bpmn:userTask><bpmn:manualTask id="Task_Transfer_Paper_File" name="Transfer Paper File to Engineering"><bpmn:incoming>Flow_RAS_05</bpmn:incoming><bpmn:outgoing>Flow_RAS_06</bpmn:outgoing></bpmn:manualTask><bpmn:userTask id="Task_Locate_Building" name="Locate Building on Map"><bpmn:incoming>Flow_RAS_06</bpmn:incoming><bpmn:outgoing>Flow_RAS_07</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Engineering_Inspection" name="Inspect Site"><bpmn:incoming>Flow_RAS_07</bpmn:incoming><bpmn:outgoing>Flow_RAS_08</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Manual_Spatial_Check" name="Check Restrictions on Maps"><bpmn:incoming>Flow_RAS_08</bpmn:incoming><bpmn:outgoing>Flow_RAS_09</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Committee_Review" name="Committee Reviews File (~80 per Meeting)"><bpmn:incoming>Flow_RAS_09</bpmn:incoming><bpmn:incoming>Flow_RAS_18</bpmn:incoming><bpmn:outgoing>Flow_RAS_10</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_Committee_Decision" name="Committee Decision?" gatewayDirection="Diverging"><bpmn:incoming>Flow_RAS_10</bpmn:incoming><bpmn:outgoing>Flow_RAS_Approve</bpmn:outgoing><bpmn:outgoing>Flow_RAS_Docs</bpmn:outgoing><bpmn:outgoing>Flow_RAS_Reject</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_Calculate_Fee" name="Calculate Fee and Deduct Deposit"><bpmn:incoming>Flow_RAS_Approve</bpmn:incoming><bpmn:outgoing>Flow_RAS_11</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Issue_Payment_Voucher" name="Issue Paper Payment Voucher"><bpmn:incoming>Flow_RAS_11</bpmn:incoming><bpmn:outgoing>Flow_RAS_12</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Pay_Fees" name="Pay in Full or by Instalments"><bpmn:incoming>Flow_RAS_12</bpmn:incoming><bpmn:outgoing>Flow_RAS_13</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Issue_Certificate" name="Print and Sign Certificate"><bpmn:documentation>The case describes certificate printing and signature but does not clearly identify the responsible office or specify certificate timing during instalments.</bpmn:documentation><bpmn:incoming>Flow_RAS_13</bpmn:incoming><bpmn:outgoing>Flow_RAS_14</bpmn:outgoing></bpmn:userTask><bpmn:manualTask id="Task_Mail_Certificate_Utilities" name="Mail Certificate Copy to Utilities"><bpmn:incoming>Flow_RAS_14</bpmn:incoming><bpmn:outgoing>Flow_RAS_15</bpmn:outgoing></bpmn:manualTask><bpmn:endEvent id="End_Reconciliation_Complete" name="Certificate Issued; Copy Sent"><bpmn:incoming>Flow_RAS_15</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_Request_Documents" name="Request Additional Documents"><bpmn:incoming>Flow_RAS_Docs</bpmn:incoming><bpmn:outgoing>Flow_RAS_16</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Applicant_Submit_Missing_Docs" name="Submit Missing Documents"><bpmn:incoming>Flow_RAS_16</bpmn:incoming><bpmn:outgoing>Flow_RAS_17</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TechCenter_Route_Docs" name="Receive and Route Resubmitted Documents"><bpmn:documentation>The case does not specify which office receives resubmitted documents or the exact point where committee review resumes. The depicted routing is a working representation.</bpmn:documentation><bpmn:incoming>Flow_RAS_17</bpmn:incoming><bpmn:outgoing>Flow_RAS_18</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Receive_Rejection" name="Receive Rejection Decision (Channel TBC)"><bpmn:incoming>Flow_RAS_Reject</bpmn:incoming><bpmn:outgoing>Flow_RAS_19</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_File_Appeal" name="Submit Paper Appeal Within 30 Days"><bpmn:incoming>Flow_RAS_19</bpmn:incoming><bpmn:outgoing>Flow_RAS_20</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Review_Appeal" name="Separate Committee Reviews Appeal"><bpmn:incoming>Flow_RAS_20</bpmn:incoming><bpmn:outgoing>Flow_RAS_21</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_Appeal_Outcome" name="Appeal Review Ends; Next Steps TBC"><bpmn:incoming>Flow_RAS_21</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_RAS_01" sourceRef="Start_Recon_Application" targetRef="Task_Submit_Paper_Dossier" /><bpmn:sequenceFlow id="Flow_RAS_02" sourceRef="Task_Submit_Paper_Dossier" targetRef="Task_Check_Paper_Checklist" /><bpmn:sequenceFlow id="Flow_RAS_03" sourceRef="Task_Check_Paper_Checklist" targetRef="Task_Register_Local_Excel" /><bpmn:sequenceFlow id="Flow_RAS_04" sourceRef="Task_Register_Local_Excel" targetRef="Task_Collect_Deposit" /><bpmn:sequenceFlow id="Flow_RAS_05" sourceRef="Task_Collect_Deposit" targetRef="Task_Transfer_Paper_File" /><bpmn:sequenceFlow id="Flow_RAS_06" sourceRef="Task_Transfer_Paper_File" targetRef="Task_Locate_Building" /><bpmn:sequenceFlow id="Flow_RAS_07" sourceRef="Task_Locate_Building" targetRef="Task_Engineering_Inspection" /><bpmn:sequenceFlow id="Flow_RAS_08" sourceRef="Task_Engineering_Inspection" targetRef="Task_Manual_Spatial_Check" /><bpmn:sequenceFlow id="Flow_RAS_09" sourceRef="Task_Manual_Spatial_Check" targetRef="Task_Committee_Review" /><bpmn:sequenceFlow id="Flow_RAS_10" sourceRef="Task_Committee_Review" targetRef="Gateway_Committee_Decision" /><bpmn:sequenceFlow id="Flow_RAS_Approve" sourceRef="Gateway_Committee_Decision" targetRef="Task_Calculate_Fee" name="Approved" /><bpmn:sequenceFlow id="Flow_RAS_Docs" sourceRef="Gateway_Committee_Decision" targetRef="Task_Request_Documents" name="Additional Documents Required" /><bpmn:sequenceFlow id="Flow_RAS_Reject" sourceRef="Gateway_Committee_Decision" targetRef="Task_Receive_Rejection" name="Rejected" /><bpmn:sequenceFlow id="Flow_RAS_11" sourceRef="Task_Calculate_Fee" targetRef="Task_Issue_Payment_Voucher" /><bpmn:sequenceFlow id="Flow_RAS_12" sourceRef="Task_Issue_Payment_Voucher" targetRef="Task_Pay_Fees" /><bpmn:sequenceFlow id="Flow_RAS_13" sourceRef="Task_Pay_Fees" targetRef="Task_Issue_Certificate" /><bpmn:sequenceFlow id="Flow_RAS_14" sourceRef="Task_Issue_Certificate" targetRef="Task_Mail_Certificate_Utilities" /><bpmn:sequenceFlow id="Flow_RAS_15" sourceRef="Task_Mail_Certificate_Utilities" targetRef="End_Reconciliation_Complete" /><bpmn:sequenceFlow id="Flow_RAS_16" sourceRef="Task_Request_Documents" targetRef="Task_Applicant_Submit_Missing_Docs" /><bpmn:sequenceFlow id="Flow_RAS_17" sourceRef="Task_Applicant_Submit_Missing_Docs" targetRef="Task_TechCenter_Route_Docs" /><bpmn:sequenceFlow id="Flow_RAS_18" sourceRef="Task_TechCenter_Route_Docs" targetRef="Task_Committee_Review" name="Resubmitted File — Routing Assumption" /><bpmn:sequenceFlow id="Flow_RAS_19" sourceRef="Task_Receive_Rejection" targetRef="Task_File_Appeal" /><bpmn:sequenceFlow id="Flow_RAS_20" sourceRef="Task_File_Appeal" targetRef="Task_Review_Appeal" /><bpmn:sequenceFlow id="Flow_RAS_21" sourceRef="Task_Review_Appeal" targetRef="End_Appeal_Outcome" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Process_ASIS_Reconciliation"><bpmndi:BPMNPlane id="Plane_Process_ASIS_Reconciliation" bpmnElement="Collaboration_Process_ASIS_Reconciliation"><bpmndi:BPMNShape id="Participant_Process_ASIS_Reconciliation_di" bpmnElement="Participant_Process_ASIS_Reconciliation" isHorizontal="true"><dc:Bounds x="100" y="100" width="2665" height="882" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_ASIS_Recon_Applicant_di" bpmnElement="Lane_ASIS_Recon_Applicant" isHorizontal="true"><dc:Bounds x="130" y="100" width="2635" height="126" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_ASIS_Recon_TechCenter_di" bpmnElement="Lane_ASIS_Recon_TechCenter" isHorizontal="true"><dc:Bounds x="130" y="226" width="2635" height="126" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_ASIS_Recon_Engi