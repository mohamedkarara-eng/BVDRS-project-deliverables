<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_TOBE_Reconciliation" targetNamespace="https://strategizeit.example/bvdrs/bpmn" exporter="OpenAI BPMN Draft Generator" exporterVersion="1.0"><bpmn:collaboration id="Collaboration_Process_TOBE_Reconciliation"><bpmn:participant id="Participant_Process_TOBE_Reconciliation" name="TO-BE Process B — Proposed Reconciliation Application Lifecycle" processRef="Process_TOBE_Reconciliation" /></bpmn:collaboration><bpmn:process id="Process_TOBE_Reconciliation" name="TO-BE Process B — Proposed Reconciliation Application Lifecycle" isExecutable="false"><bpmn:documentation>Proposed TO-BE conceptual workflow. It preserves assisted intake, treats GIS as preliminary screening rather than an automatic legal decision, and keeps field inspection as the baseline because the Engineering stakeholder states it is required before a decision. Any Fast-Track exception is excluded from the baseline until formally approved. Deposit timing/refund treatment, certificate timing during instalments, utility integration scope, appeal notification trigger, and the effect of an appeal on removal remain Open Issues. The 30-day appeal gateway is conceptual and is not modeled as an executable timer.</bpmn:documentation><bpmn:laneSet id="LaneSet_Process_TOBE_Reconciliation"><bpmn:lane id="Lane_TOBE_Recon_Applicant" name="Citizen / Legal Agent"><bpmn:flowNodeRef>Start_TOBE_Application</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Channel</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Portal_Intake</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Submit_Missing</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Pay</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Clerk" name="Technical Center Clerk (Assisted Service)"><bpmn:flowNodeRef>Task_TOBE_Assisted_Intake</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Request_Missing</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Route_Missing</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Platform" name="BVDRS Application and Spatial Services"><bpmn:flowNodeRef>Gateway_TOBE_Intake_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Check_Completeness</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Docs_Complete</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Create_Case</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Spatial_Screen</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Spatial_Flag</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Engineering" name="District Engineering / GIS Review"><bpmn:flowNodeRef>Task_TOBE_Manual_Spatial_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Field_Inspection</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Committee" name="Reconciliation Committee"><bpmn:flowNodeRef>Task_TOBE_Committee_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Committee_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Committee_Request_Docs</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Finance" name="Finance Department"><bpmn:flowNodeRef>Task_TOBE_Deposit_Policy</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Calculate_Fee</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Payment_Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Record_Payment</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Admin" name="Certificate Administration / Utility Verification"><bpmn:flowNodeRef>Task_TOBE_Issue_Certificate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Utility_Access</bpmn:flowNodeRef><bpmn:flowNodeRef>End_TOBE_Recon_Completed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Recon_Appeals" name="Appellate Committee / Legal Affairs"><bpmn:flowNodeRef>Task_TOBE_Record_Rejection</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Appeal_Filed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Appeal_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Appeal_Outcome</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Enforcement_Referral</bpmn:flowNodeRef><bpmn:flowNodeRef>End_TOBE_Enforcement_Referral</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_TOBE_Application" name="Applicant Initiates Application"><bpmn:outgoing>Flow_TR_01</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="Gateway_TOBE_Channel" name="Submission Channel?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TR_01</bpmn:incoming><bpmn:outgoing>Flow_TR_Web</bpmn:outgoing><bpmn:outgoing>Flow_TR_Assisted</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_TOBE_Portal_Intake" name="Submit Online Application and Location"><bpmn:incoming>Flow_TR_Web</bpmn:incoming><bpmn:outgoing>Flow_TR_Web_Done</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Assisted_Intake" name="Clerk Records Application and Location"><bpmn:incoming>Flow_TR_Assisted</bpmn:incoming><bpmn:outgoing>Flow_TR_Assisted_Done</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_TOBE_Intake_Merge" name="Application Record Created?" gatewayDirection="Converging"><bpmn:incoming>Flow_TR_Web_Done</bpmn:incoming><bpmn:incoming>Flow_TR_Assisted_Done</bpmn:incoming><bpmn:outgoing>Flow_TR_02</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TOBE_Check_Completeness" name="Check Required Fields and Documents"><bpmn:incoming>Flow_TR_02</bpmn:incoming><bpmn:incoming>Flow_TR_06</bpmn:incoming><bpmn:outgoing>Flow_TR_03</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_TOBE_Docs_Complete" name="Application Complete?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TR_03</bpmn:incoming><bpmn:outgoing>Flow_TR_Docs_Yes</bpmn:outgoing><bpmn:outgoing>Flow_TR_Docs_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TOBE_Create_Case" name="Create Case and Provisional Property Reference"><bpmn:documentation>A provisional identifier or location reference must not be represented as an authoritative cadastral parcel boundary.</bpmn:documentation><bpmn:incoming>Flow_TR_Docs_Yes</bpmn:incoming><bpmn:outgoing>Flow_TR_07</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_TOBE_Request_Missing" name="Request Missing Documents"><bpmn:incoming>Flow_TR_Docs_No</bpmn:incoming><bpmn:outgoing>Flow_TR_04</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Submit_Missing" name="Submit Missing Documents"><bpmn:incoming>Flow_TR_04</bpmn:incoming><bpmn:incoming>Flow_TR_18</bpmn:incoming><bpmn:outgoing>Flow_TR_05</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Route_Missing" name="Validate Resubmitted Documents"><bpmn:incoming>Flow_TR_05</bpmn:incoming><bpmn:outgoing>Flow_TR_06</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_TOBE_Spatial_Screen" name="Run Preliminary GIS Screening"><bpmn:documentation>Spatial screening supports prioritization and review; it does not by itself constitute a final legal or engineering decision. Reference-layer authority and positional tolerance require confirmation.</bpmn:documentation><bpmn:incoming>Flow_TR_07</bpmn:incoming><bpmn:outgoing>Flow_TR_08</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_TOBE_Spatial_Flag" name="Restriction or Location Uncertain?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TR_08</bpmn:incoming><bpmn:outgoing>Flow_TR_Spatial_Yes</bpmn:outgoing><bpmn:outgoing>Flow_TR_Spatial_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_TOBE_Manual_Spatial_Review" name="Review Flagged Location and Evidence"><bpmn:incoming>Flow_TR_Spatial_Yes</bpmn:incoming><bpmn:outgoing>Flow_TR_Spatial_Reviewed</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Deposit_Policy" name="Apply Approved Deposit Policy"><bpmn:documentation>The 25% deposit is stated in the case. Its timing in the proposed workflow and the refund treatment on rejection remain subject to Finance/Legal confirmation.</bpmn:documentation><bpmn:incoming>Flow_TR_Spatial_No</bpmn:incoming><bpmn:incoming>Flow_TR_Spatial_Reviewed</bpmn:incoming><bpmn:outgoing>Flow_TR_09</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Field_Inspection" name="Conduct Required Site Inspection"><bpmn:documentation>The current Engineering stakeholder position requires a site visit before a decision. Any Fast-Track exception must remain disabled until formally approved.</bpmn:documentation><bpmn:incoming>Flow_TR_09</bpmn:incoming><bpmn:outgoing>Flow_TR_10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Committee_Review" name="Committee Reviews Dossier and Findings"><bpmn:incoming>Flow_TR_10</bpmn:incoming><bpmn:incoming>Flow_TR_Appeal_Upheld</bpmn:incoming><bpmn:outgoing>Flow_TR_11</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_TOBE_Committee_Decision" name="Committee Decision?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TR_11</bpmn:incoming><bpmn:outgoing>Flow_TR_Approve</bpmn:outgoing><bpmn:outgoing>Flow_TR_Docs</bpmn:outgoing><bpmn:outgoing>Flow_TR_Reject</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TOBE_Calculate_Fee" name="Calculate Fee Using Approved Rate"><bpmn:documentation>If no approved rate exists, stop fee calculation and raise an Open Issue; never estimate an unapproved tariff.</bpmn:documentation><bpmn:incoming>Flow_TR_Approve</bpmn:incoming><bpmn:outgoing>Flow_TR_12</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_TOBE_Payment_Request" name="Issue Payment Instructions"><bpmn:incoming>Flow_TR_12</bpmn:incoming><bpmn:outgoing>Flow_TR_13</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Pay" name="Pay or Enter Approved Instalment Plan"><bpmn:documentation>Certificate timing during instalment plans is not specified in the case and must be governed by an approved business rule.</bpmn:documentation><bpmn:incoming>Flow_TR_13</bpmn:incoming><bpmn:outgoing>Flow_TR_14</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Record_Payment" name="Record Payment / Instalment Status"><bpmn:incoming>Flow_TR_14</bpmn:incoming><bpmn:outgoing>Flow_TR_15</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Issue_Certificate" name="Issue Certificate per Approved Rule"><bpmn:incoming>Flow_TR_15</bpmn:incoming><bpmn:outgoing>Flow_TR_16</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_TOBE_Utility_Access" name="Provide Certificate Verification via Approved Channel"><bpmn:documentation>Online utility API verification is a proposed integration. It requires confirmation of Phase 1 scope, authorization, security and interface availability.</bpmn:documentation><bpmn:incoming>Flow_TR_16</bpmn:incoming><bpmn:outgoing>Flow_TR_17</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_TOBE_Recon_Completed" name="Certificate Status Recorded and Available"><bpmn:incoming>Flow_TR_17</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_TOBE_Committee_Request_Docs" name="Request Additional Documents"><bpmn:incoming>Flow_TR_Docs</bpmn:incoming><bpmn:outgoing>Flow_TR_18</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Record_Rejection" name="Record Rejection and Notify Applicant"><bpmn:documentation>Notification channel and evidence of delivery must be confirmed. The case states a 30-day appeal period but does not state that filing an appeal automatically suspends removal.</bpmn:documentation><bpmn:incoming>Flow_TR_Reject</bpmn:incoming><bpmn:outgoing>Flow_TR_20</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_TOBE_Appeal_Filed" name="Appeal Within 30-Day Window?" gatewayDirection="Diverging"><bpmn:documentation>The trigger for the 30-day period and evidence of notification require legal confirmation. This is a conceptual gateway, not an executable timer.</bpmn:documentation><bpmn:incoming>Flow_TR_20</bpmn:incoming><bpmn:outgoing>Flow_TR_Appeal_Yes</bpmn:outgoing><bpmn:outgoing>Flow_TR_Appeal_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_TOBE_Appeal_Review" name="Appellate Committee Reviews Appeal"><bpmn:incoming>Flow_TR_Appeal_Yes</bpmn:incoming><bpmn:outgoing>Flow_TR_21</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_TOBE_Appeal_Outcome" name="Appeal Outcome?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TR_21</bpmn:incoming><bpmn:outgoing>Flow_TR_Appeal_Upheld</bpmn:outgoing><bpmn:outgoing>Flow_TR_Appeal_Dismissed</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_TOBE_Enforcement_Referral" name="Refer to Authorized Legal / Enforcement Procedure"><bpmn:documentation>Detailed removal workflow is not supplied in the case. No automatic stay or automatic demolition decision is assumed by this model.</bpmn:documentation><bpmn:incoming>Flow_TR_Appeal_No</bpmn:incoming><bpmn:incoming>Flow_TR_Appeal_Dismissed</bpmn:incoming><bpmn:outgoing>Flow_TR_22</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_TOBE_Enforcement_Referral" name="Referred for Authorized Follow-up; Removal Procedure Outside Model"><bpmn:incoming>Flow_TR_22</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_TR_01" sourceRef="Start_TOBE_Application" targetRef="Gateway_TOBE_Channel" /><bpmn:sequenceFlow id="Flow_TR_Web" sourceRef="Gateway_TOBE_Channel" targetRef="Task_TOBE_Portal_Intake" name="Web Portal" /><bpmn:sequenceFlow id="Flow_TR_Assisted" sourceRef="Gateway_TOBE_Channel" targetRef="Task_TOBE_Assisted_Intake" name="Assisted Center" /><bpmn:sequenceFlow id="Flow_TR_Web_Done" sourceRef="Task_TOBE_Portal_Intake" targetRef="Gateway_TOBE_Intake_Merge" /><bpmn:sequenceFlow id="Flow_TR_Assisted_Done" sourceRef="Task_TOBE_Assisted_Intake" targetRef="Gateway_TOBE_Intake_Merge" /><bpmn:sequenceFlow id="Flow_TR_02" sourceRef="Gateway_TOBE_Intake_Merge" targetRef="Task_TOBE_Check_Completeness" /><bpmn:sequenceFlow id="Flow_TR_03" sourceRef="Task_TOBE_Check_Completeness" targetRef="Gateway_TOBE_Docs_Complete" /><bpmn:sequenceFlow id="Flow_TR_Docs_Yes" sourceRef="Gateway_TOBE_Docs_Complete" targetRef="Task_TOBE_Create_Case" name="Yes" /><bpmn:sequenceFlow id="Flow_TR_Docs_No" sourceRef="Gateway_TOBE_Docs_Complete" targetRef="Task_TOBE_Request_Missing" name="No" /><bpmn:sequenceFlow id="Flow_TR_04" sourceRef="Task_TOBE_Request_Missing" targetRef="Task_TOBE_Submit_Missing" /><bpmn:sequenceFlow id="Flow_TR_05" sourceRef="Task_TOBE_Submit_Missing" targetRef="Task_TOBE_Route_Missing" /><bpmn:sequenceFlow id="Flow_TR_06" sourceRef="Task_TOBE_Route_Missing" targetRef="Task_TOBE_Check_Completeness" name="Revalidate Updated Record" /><bpmn:sequenceFlow id="Flow_TR_07" sourceRef="Task_TOBE_Create_Case" targetRef="Task_TOBE_Spatial_Screen" /><bpmn:sequenceFlow id="Flow_TR_08" sourceRef="Task_TOBE_Spatial_Screen" targetRef="Gateway_TOBE_Spatial_Flag" /><bpmn:sequenceFlow id="Flow_TR_Spatial_Yes" sourceRef="Gateway_TOBE_Spatial_Flag" targetRef="Task_TOBE_Manual_Spatial_Review" name="Flag / Uncertain Location" /><bpmn:sequenceFlow id="Flow_TR_Spatial_No" sourceRef="Gateway_TOBE_Spatial_Flag" targetRef="Task_TOBE_Deposit_Policy" name="No Flag Identified" /><bpmn:sequenceFlow id="Flow_TR_Spatial_Reviewed" sourceRef="Task_TOBE_Manual_Spatial_Review" targetRef="Task_TOBE_Deposit_Policy" name="Review Result Recorded" /><bpmn:sequenceFlow id="Flow_TR_09" sourceRef="Task_TOBE_Deposit_Policy" targetRef="Task_TOBE_Field_Inspection" /><bpmn:sequenceFlow id="Flow_TR_10" sourceRef="Task_TOBE_Field_Inspection" targetRef="Task_TOBE_Committee_Review" /><bpmn:sequenceFlow id="Flow_TR_11" sourceRef="Task_TOBE_Committee_Review" targetRef="Gateway_TOBE_Committee_Decision" /><bpmn:sequenceFlow id="Flow_TR_Approve" sourceRef="Gateway_TOBE_Committee_Decision" targetRef="Task_TOBE_Calculate_Fee" name="Approved" /><bpmn:sequenceFlow id="Flow_TR_Docs" sourceRef="Gateway_TOBE_Committee_Decision" targetRef="Task_TOBE_Committee_Request_Docs" name="Additional Documents" /><bpmn:sequenceFlow id="Flow_TR_Reject" sourceRef="Gateway_TOBE_Committee_Decision" targetRef="Task_TOBE_Record_Rejection" name="Rejected" /><bpmn:sequenceFlow id="Flow_TR_12" sourceRef="Task_TOBE_Calculate_Fee" targetRef="Task_TOBE_Payment_Request" /><bpmn:sequenceFlow id="Flow_TR_13" sourceRef="Task_TOBE_Payment_Request" targetRef="Task_TOBE_Pay" /><bpmn:sequenceFlow id="Flow_TR_14" sourceRef="Task_TOBE_Pay" targetRef="Task_TOBE_Record_Payment" /><bpmn:sequenceFlow id="Flow_TR_15" sourceRef="Task_TOBE_Record_Payment" targetRef="Task_TOBE_Issue_Certificate" /><bpmn:sequenceFlow id="Flow_TR_16" sourceRef="Task_TOBE_Issue_Certificate" targetRef="Task_TOBE_Utility_Access" /><bpmn:sequenceFlow id="Flow_TR_17" sourceRef="Task_TOBE_Utility_Access" targetRef="End_TOBE_Recon_Completed" /><bpmn:sequenceFlow id="Flow_TR_18" sourceRef="Task_TOBE_Committee_Request_Docs" targetRef="Task_TOBE_Submit_Missing" /><bpmn:sequenceFlow id="Flow_TR_20" sourceRef="Task_TOBE_Record_Rejection" targetRef="Gateway_TOBE_Appeal_Filed" /><bpmn:sequenceFlow id="Flow_TR_Appeal_Yes" sourceRef="Gateway_TOBE_Appeal_Filed" targetRef="Task_TOBE_Appeal_Review" name="Yes" /><bpmn:sequenceFlow id="Flow_TR_Appeal_No" sourceRef="Gateway_TOBE_Appeal_Filed" targetRef="Task_TOBE_Enforcement_Referral" name="No / Window Expired" /><bpmn:sequenceFlow id="Flow_TR_21" sourceRef="Task_TOBE_Appeal_Review" targetRef="Gateway_TOBE_Appeal_Outcome" /><bpmn:sequenceFlow id="Flow_TR_Appeal_Upheld" sourceRef="Gateway_TOBE_Appeal_Outcome" targetRef="Task_TOBE_Committee_Review" name="Upheld — Reconsider per Approved Procedure" /><bpmn:sequenceFlow id="Flow_TR_Appeal_Dismissed" sourceRef="Gateway_TOBE_Appeal_Outcome" targetRef="Task_TOBE_Enforcement_Referral" name="Dismissed" /><bpmn:sequenceFlow id="Flow_TR_22" sourceRef="Task_TOBE_Enforcement_Referral" targetRef="End_TOBE_Enforcement_Referral" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Process_TOBE_Reconciliation"><bpmndi:BPMNPlane id="Plane_Process_TOBE_Reconciliation" bpmnElement="Collaboration_Process_TOBE_Reconciliation"><bpmndi:BPMNShape id="Participant_Process_TOBE_Reconciliation_di" bpmnElement="Participant_P