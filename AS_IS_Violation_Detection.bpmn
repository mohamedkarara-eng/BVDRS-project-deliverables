<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ASIS_Violation_Detection" targetNamespace="https://strategizeit.example/bvdrs/bpmn" exporter="OpenAI BPMN Draft Generator" exporterVersion="1.0"><bpmn:collaboration id="Collaboration_Process_ASIS_Violation_Detection"><bpmn:participant id="Participant_Process_ASIS_Violation_Detection" name="AS-IS Process A — Building Violation Detection and Reporting" processRef="Process_ASIS_Violation_Detection" /></bpmn:collaboration><bpmn:process id="Process_ASIS_Violation_Detection" name="AS-IS Process A — Building Violation Detection and Reporting" isExecutable="false"><bpmn:documentation>AS-IS model based on the assessment. The case says some field reports do not return to Central GIS, but it does not quantify the missing-report rate. The map may therefore remain incomplete; no percentage or permanent-loss rate is assumed.</bpmn:documentation><bpmn:laneSet id="LaneSet_Process_ASIS_Violation_Detection"><bpmn:lane id="Lane_ASIS_Det_External" name="National Remote Sensing / Imagery Provider"><bpmn:flowNodeRef>Start_Quarterly_Imagery</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Provide_Imagery</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Det_GIS" name="Central GIS Unit (4 Analysts)"><bpmn:flowNodeRef>Task_Manual_Comparison</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Mark_Suspected_Changes</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Print_Send_Maps</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Update_GIS_Map</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Detection_Map_Updated</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ASIS_Det_Field" name="District Engineering Offices (25 Engineers / 6 Districts)"><bpmn:flowNodeRef>Task_Visit_Site</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Personal_Phone_Photos</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Enter_District_Excel</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Report_Returned</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Detection_Report_Not_Returned</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_Quarterly_Imagery" name="Quarterly Imagery Received"><bpmn:outgoing>Flow_Det_01</bpmn:outgoing></bpmn:startEvent><bpmn:manualTask id="Task_Provide_Imagery" name="Deliver Quarterly 50 cm Imagery"><bpmn:incoming>Flow_Det_01</bpmn:incoming><bpmn:outgoing>Flow_Det_02</bpmn:outgoing></bpmn:manualTask><bpmn:userTask id="Task_Manual_Comparison" name="Compare Images in ArcGIS Pro (~6 Weeks)"><bpmn:incoming>Flow_Det_02</bpmn:incoming><bpmn:outgoing>Flow_Det_03</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Mark_Suspected_Changes" name="Mark Suspected Changes"><bpmn:incoming>Flow_Det_03</bpmn:incoming><bpmn:outgoing>Flow_Det_04</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Print_Send_Maps" name="Print and Send Paper Maps"><bpmn:incoming>Flow_Det_04</bpmn:incoming><bpmn:outgoing>Flow_Det_05</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Visit_Site" name="Inspect Site and Complete Paper Mahdar"><bpmn:incoming>Flow_Det_05</bpmn:incoming><bpmn:outgoing>Flow_Det_06</bpmn:outgoing></bpmn:userTask><bpmn:manualTask id="Task_Personal_Phone_Photos" name="Take Phone Photos and Estimate Area"><bpmn:incoming>Flow_Det_06</bpmn:incoming><bpmn:outgoing>Flow_Det_07</bpmn:outgoing></bpmn:manualTask><bpmn:userTask id="Task_Enter_District_Excel" name="Enter Findings in District Excel"><bpmn:incoming>Flow_Det_07</bpmn:incoming><bpmn:outgoing>Flow_Det_08</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_Report_Returned" name="Report Returned to Central GIS?" gatewayDirection="Diverging"><bpmn:incoming>Flow_Det_08</bpmn:incoming><bpmn:outgoing>Flow_Det_Yes</bpmn:outgoing><bpmn:outgoing>Flow_Det_No</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_Update_GIS_Map" name="Update GIS Map from Returned Report"><bpmn:incoming>Flow_Det_Yes</bpmn:incoming><bpmn:outgoing>Flow_Det_09</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="End_Detection_Map_Updated" name="Cycle Ends — Map Updated"><bpmn:incoming>Flow_Det_09</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="End_Detection_Report_Not_Returned" name="Cycle Ends — Map May Remain Incomplete"><bpmn:incoming>Flow_Det_No</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Det_01" sourceRef="Start_Quarterly_Imagery" targetRef="Task_Provide_Imagery" /><bpmn:sequenceFlow id="Flow_Det_02" sourceRef="Task_Provide_Imagery" targetRef="Task_Manual_Comparison" /><bpmn:sequenceFlow id="Flow_Det_03" sourceRef="Task_Manual_Comparison" targetRef="Task_Mark_Suspected_Changes" /><bpmn:sequenceFlow id="Flow_Det_04" sourceRef="Task_Mark_Suspected_Changes" targetRef="Task_Print_Send_Maps" /><bpmn:sequenceFlow id="Flow_Det_05" sourceRef="Task_Print_Send_Maps" targetRef="Task_Visit_Site" /><bpmn:sequenceFlow id="Flow_Det_06" sourceRef="Task_Visit_Site" targetRef="Task_Personal_Phone_Photos" /><bpmn:sequenceFlow id="Flow_Det_07" sourceRef="Task_Personal_Phone_Photos" targetRef="Task_Enter_District_Excel" /><bpmn:sequenceFlow id="Flow_Det_08" sourceRef="Task_Enter_District_Excel" targetRef="Gateway_Report_Returned" /><bpmn:sequenceFlow id="Flow_Det_Yes" sourceRef="Gateway_Report_Returned" targetRef="Task_Update_GIS_Map" name="Yes — Report Returned" /><bpmn:sequenceFlow id="Flow_Det_No" sourceRef="Gateway_Report_Returned" targetRef="End_Detection_Report_Not_Returned" name="No — Report Not Returned" /><bpmn:sequenceFlow id="Flow_Det_09" sourceRef="Task_Update_GIS_Map" targetRef="End_Detection_Map_Updated" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Process_ASIS_Violation_Detection"><bpmndi:BPMNPlane id="Plane_Process_ASIS_Violation_Detection" bpmnElement="Collaboration_Process_ASIS_Violation_Detection"><bpmndi:BPMNShape id="Participant_Process_ASIS_Violation_Detection_di" bpmnElement="Participant_Process_ASIS_Violation_Detection" isHorizontal="true"><dc:Bounds x=