<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_TOBE_Violation_Detection" targetNamespace="https://strategizeit.example/bvdrs/bpmn" exporter="OpenAI BPMN Draft Generator" exporterVersion="1.0"><bpmn:collaboration id="Collaboration_Process_TOBE_Violation_Detection"><bpmn:participant id="Participant_Process_TOBE_Violation_Detection" name="TO-BE Process A — Proposed Violation Detection and Field Reporting" processRef="Process_TOBE_Violation_Detection" /></bpmn:collaboration><bpmn:process id="Process_TOBE_Violation_Detection" name="TO-BE Process A — Proposed Violation Detection and Field Reporting" isExecutable="false"><bpmn:documentation>Proposed TO-BE process, not a statement of approved scope. It uses existing quarterly imagery as the confirmed baseline. Automated detection, processing-time targets, mobile/offline capture and digital tickets are proposed capabilities subject to feasibility, procurement, security and governance validation. A machine-generated candidate is not a final legal finding; authorized personnel determine enforcement actions.</bpmn:documentation><bpmn:laneSet id="LaneSet_Process_TOBE_Violation_Detection"><bpmn:lane id="Lane_TOBE_Det_External" name="National Remote Sensing / Imagery Provider"><bpmn:flowNodeRef>Start_TOBE_Imagery</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Provide_Imagery</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Det_Engine" name="BVDRS Imagery Ingestion and Change Detection"><bpmn:flowNodeRef>Task_TOBE_Ingest_QA</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Change_Detection</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Filter_Records</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Candidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_NoCandidate</bpmn:flowNodeRef><bpmn:flowNodeRef>End_TOBE_NoCandidate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Create_Ticket</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Det_GIS" name="Central GIS Unit (Human Validation)"><bpmn:flowNodeRef>Task_TOBE_GIS_Review</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Det_Field" name="District Field Engineering"><bpmn:flowNodeRef>Task_TOBE_Offline_Navigation</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Field_Evidence</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Connectivity</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Store_Offline</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Retry_Sync</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TOBE_Reconnected</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TOBE_Det_Core" name="Central BVDRS Repository / GIS / Reporting"><bpmn:flowNodeRef>Task_TOBE_Sync_Immediate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Sync_After_Reconnect</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TOBE_Update_Record</bpmn:flowNodeRef><bpmn:flowNodeRef>End_TOBE_Detection_Logged</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Start_TOBE_Imagery" name="Quarterly Imagery Received"><bpmn:outgoing>Flow_TD_01</bpmn:outgoing></bpmn:startEvent><bpmn:manualTask id="Task_TOBE_Provide_Imagery" name="Provide Existing Quarterly 50 cm Imagery"><bpmn:incoming>Flow_TD_01</bpmn:incoming><bpmn:outgoing>Flow_TD_02</bpmn:outgoing></bpmn:manualTask><bpmn:serviceTask id="Task_TOBE_Ingest_QA" name="Ingest Imagery and Check Spatial Reference"><bpmn:incoming>Flow_TD_02</bpmn:incoming><bpmn:outgoing>Flow_TD_03</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_TOBE_Change_Detection" name="Run Change Detection (Turnaround TBC)"><bpmn:documentation>The ≤48-hour processing target is proposed, not a confirmed requirement. Quarterly source imagery does not enable weekly new-change detection by itself.</bpmn:documentation><bpmn:incoming>Flow_TD_03</bpmn:incoming><bpmn:outgoing>Flow_TD_04</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_TOBE_Filter_Records" name="Compare Candidates with Permit / Case Records"><bpmn:documentation>Feasibility and completeness of permit/active-case data must be validated during data analysis.</bpmn:documentation><bpmn:incoming>Flow_TD_04</bpmn:incoming><bpmn:outgoing>Flow_TD_05</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_TOBE_Candidate" name="Candidate Change Identified?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TD_05</bpmn:incoming><bpmn:outgoing>Flow_TD_No</bpmn:outgoing><bpmn:outgoing>Flow_TD_Yes</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TOBE_NoCandidate" name="Record No Candidate Requiring Field Review"><bpmn:incoming>Flow_TD_No</bpmn:incoming><bpmn:outgoing>Flow_TD_No_End</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_TOBE_NoCandidate" name="Cycle Closed — No Field Ticket"><bpmn:incoming>Flow_TD_No_End</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_TOBE_GIS_Review" name="GIS Analyst Validates Candidate Polygon"><bpmn:incoming>Flow_TD_Yes</bpmn:incoming><bpmn:outgoing>Flow_TD_06</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_TOBE_Create_Ticket" name="Create and Assign Digital Inspection Ticket"><bpmn:incoming>Flow_TD_06</bpmn:incoming><bpmn:outgoing>Flow_TD_07</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_TOBE_Offline_Navigation" name="Navigate Using Offline Map Data"><bpmn:incoming>Flow_TD_07</bpmn:incoming><bpmn:outgoing>Flow_TD_08</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Field_Evidence" name="Inspect Site and Capture Digital Evidence"><bpmn:incoming>Flow_TD_08</bpmn:incoming><bpmn:outgoing>Flow_TD_09</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_TOBE_Connectivity" name="Connection Available for Sync?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TD_09</bpmn:incoming><bpmn:outgoing>Flow_TD_Yes_Sync</bpmn:outgoing><bpmn:outgoing>Flow_TD_No_Store</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TOBE_Sync_Immediate" name="Sync Inspection Record to Central Repository"><bpmn:incoming>Flow_TD_Yes_Sync</bpmn:incoming><bpmn:outgoing>Flow_TD_12a</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_TOBE_Store_Offline" name="Store Locally and Queue Sync"><bpmn:incoming>Flow_TD_No_Store</bpmn:incoming><bpmn:outgoing>Flow_TD_10</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_TOBE_Retry_Sync" name="Wait for Connection and Retry Sync"><bpmn:incoming>Flow_TD_10</bpmn:incoming><bpmn:incoming>Flow_TD_Retry_No</bpmn:incoming><bpmn:outgoing>Flow_TD_11</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_TOBE_Reconnected" name="Connection Restored?" gatewayDirection="Diverging"><bpmn:incoming>Flow_TD_11</bpmn:incoming><bpmn:outgoing>Flow_TD_Retry_No</bpmn:outgoing><bpmn:outgoing>Flow_TD_Retry_Yes</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TOBE_Sync_After_Reconnect" name="Sync Queued Inspection Record"><bpmn:incoming>Flow_TD_Retry_Yes</bpmn:incoming><bpmn:outgoing>Flow_TD_12b</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_TOBE_Update_Record" name="Update GIS Record for Authorized Follow-up"><bpmn:incoming>Flow_TD_12a</bpmn:incoming><bpmn:incoming>Flow_TD_12b</bpmn:incoming><bpmn:outgoing>Flow_TD_13</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="End_TOBE_Detection_Logged" name="Evidence Recorded; Enforcement Decision Remains with Authorized Officers"><bpmn:incoming>Flow_TD_13</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_TD_01" sourceRef="Start_TOBE_Imagery" targetRef="Task_TOBE_Provide_Imagery" /><bpmn:sequenceFlow id="Flow_TD_02" sourceRef="Task_TOBE_Provide_Imagery" targetRef="Task_TOBE_Ingest_QA" /><bpmn:sequenceFlow id="Flow_TD_03" sourceRef="Task_TOBE_Ingest_QA" targetRef="Task_TOBE_Change_Detection" /><bpmn:sequenceFlow id="Flow_TD_04" sourceRef="Task_TOBE_Change_Detection" targetRef="Task_TOBE_Filter_Records" /><bpmn:sequenceFlow id="Flow_TD_05" sourceRef="Task_TOBE_Filter_Records" targetRef="Gateway_TOBE_Candidate" /><bpmn:sequenceFlow id="Flow_TD_No" sourceRef="Gateway_TOBE_Candidate" targetRef="Task_TOBE_NoCandidate" name="No Candidate" /><bpmn:sequenceFlow id="Flow_TD_No_End" sourceRef="Task_TOBE_NoCandidate" targetRef="End_TOBE_NoCandidate" /><bpmn:sequenceFlow id="Flow_TD_Yes" sourceRef="Gateway_TOBE_Candidate" targetRef="Task_TOBE_GIS_Review" name="Potential Change" /><bpmn:sequenceFlow id="Flow_TD_06" sourceRef="Task_TOBE_GIS_Review" targetRef="Task_TOBE_Create_Ticket" /><bpmn:sequenceFlow id="Flow_TD_07" sourceRef="Task_TOBE_Create_Ticket" targetRef="Task_TOBE_Offline_Navigation" /><bpmn:sequenceFlow id="Flow_TD_08" sourceRef="Task_TOBE_Offline_Navigation" targetRef="Task_TOBE_Field_Evidence" /><bpmn:sequenceFlow id="Flow_TD_09" sourceRef="Task_TOBE_Field_Evidence" targetRef="Gateway_TOBE_Connectivity" /><bpmn:sequenceFlow id="Flow_TD_Yes_Sync" sourceRef="Gateway_TOBE_Connectivity" targetRef="Task_TOBE_Sync_Immediate" name="Yes" /><bpmn:sequenceFlow id="Flow_TD_No_Store" sourceRef="Gateway_TOBE_Connectivity" targetRef="Task_TOBE_Store_Offline" name="No" /><bpmn:sequenceFlow id="Flow_TD_10" sourceRef="Task_TOBE_Store_Offline" targetRef="Task_TOBE_Retry_Sync" /><bpmn:sequenceFlow id="Flow_TD_11" sourceRef="Task_TOBE_Retry_Sync" targetRef="Gateway_TOBE_Reconnected" /><bpmn:sequenceFlow id="Flow_TD_Retry_No" sourceRef="Gateway_TOBE_Reconnected" targetRef="Task_TOBE_Retry_Sync" name="No — Retry" /><bpmn:sequenceFlow id="Flow_TD_Retry_Yes" sourceRef="Gateway_TOBE_Reconnected" targetRef="Task_TOBE_Sync_After_Reconnect" name="Yes" /><bpmn:sequenceFlow id="Flow_TD_12a" sourceRef="Task_TOBE_Sync_Immediate" targetRef="Task_TOBE_Update_Record" /><bpmn:sequenceFlow id="Flow_TD_12b" sourceRef="Task_TOBE_Sync_After_Reconnect" targetRef="Task_TOBE_Update_Record" /><bpmn:sequenceFlow id="Flow_TD_13" sourceRef="Task_TOBE_Update_Record" targetRef="End_TOBE_Detection_Logged" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Process_TOBE_Violation_Detection"><bpmndi:BPMNPlane id="Plane_Process_TO